# JobFit AI - Backend Configuration

# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example MongoDB Atlas URI: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jobfitai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/jobfitai

# JWT Secret for Session Authentication
JWT_SECRET=jobfitai_secure_jwt_secret_token_key_2026

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model Name (use a current generateContent model from Google AI Studio)
GEMINI_MODEL=gemini-3.8-flash

# Environment
NODE_ENV=development
